DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

JWT_SECRET=change-this-to-a-long-random-string
JWT_REFRESH_SECRET=another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=

# Checks run labeled with this region (multi-worker setups use one value each)
REGION=self
# Set true on extra workers to run the scheduler without the HTTP server
WORKER_ONLY=false

# Retention windows (days)
CHECK_RETENTION_DAYS=7
HOURLY_RETENTION_DAYS=90
DAILY_RETENTION_DAYS=730

# Engine tuning
CHECK_CONCURRENCY=10
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# Optional: Twilio SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
